rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Product and hero imagery: publicly readable, uploadable by authenticated staff/admins
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /hero/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Return proof uploads
    match /returns/{allPaths=**} {
      allow read: if true;
      allow write: if true; // Public customers can attach defect/return photos
    }
  }
}
